{
  "manifest_version": 2,
  "name": "Bombacha Extensões — Android",
  "version": "1.0.64",
  "description": "Bombacha integrada ao Firefox Android: embeds de YouTube, Instagram, TikTok, X/Twitter e Vocaroo, links diretos, autor compacto e atualização do fórum.",
  "permissions": [
    "storage",
    "https://vk.ru/*",
    "*://*.vk.ru/*",
    "https://vk.com/*",
    "*://*.vk.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://vk.com/away.php*",
        "https://vk.ru/away.php*",
        "https://m.vk.ru/away.php*"
      ],
      "js": [
        "away/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://vk.ru/*",
        "*://*.vk.ru/*",
        "https://vk.com/*",
        "*://*.vk.com/*"
      ],
      "js": [
        "social-embeds-mobile.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://vk.ru/*",
        "*://*.vk.ru/*",
        "https://vk.com/*",
        "*://*.vk.com/*"
      ],
      "js": [
        "mobile-forum-ui.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://vk.ru/*",
        "*://*.vk.ru/*",
        "https://vk.com/*",
        "*://*.vk.com/*"
      ],
      "js": [
        "topic-authors.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://vk.ru/*",
        "*://*.vk.ru/*",
        "https://vk.com/*",
        "*://*.vk.com/*"
      ],
      "js": [
        "mobile-author-fallback.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_icon": "vk_icon48_v361.png",
    "default_popup": "popup.html",
    "default_title": "Bombacha Android"
  },
  "icons": {
    "16": "vk_icon16_v361.png",
    "48": "vk_icon48_v361.png",
    "128": "vk_icon128_v361.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{233e9592-8c9a-4629-ba9c-cdb986ce1a32}",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "120.0"
    }
  }
}
